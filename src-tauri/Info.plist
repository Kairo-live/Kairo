<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Shown by macOS the first time KAIRO requests the microphone.
         Without this key, the OS suppresses the prompt and the app
         silently has no audio access. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>KAIRO listens to your sermon audio to detect Bible verses in real time.</string>

    <!-- Allow loading localhost over HTTP (the bundled Node server). -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>

    <!-- Without this, macOS App Nap throttles the webview's JS timers and
         real-time audio processing once the window sits unfocused/occluded
         for a while — exactly the normal state during a live service, where
         the operator isn't clicking the app while it's meant to keep
         listening. Confirmed live: the AudioWorklet capture graph went
         completely silent for minutes at a time with no error, recovering
         on its own later — not a crash, App Nap suspending a background
         process that was never told it's allowed to keep running at full
         throttle. Capturing microphone input doesn't earn the automatic
         "this app is making sound" exemption the way audio OUTPUT does. -->
    <key>NSAppSleepDisabled</key>
    <true/>
</dict>
</plist>

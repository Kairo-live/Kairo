{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "KAIRO main window capabilities",
  "windows": ["main", "kairo-*"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "updater:default",
    "dialog:allow-open",
    "clipboard-manager:allow-read-text",
    "core:window:allow-create",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-start-dragging",
    "core:webview:allow-create-webview-window",
    "allow-get-server-port",
    "allow-get-server-token",
    "allow-get-server-config",
    "allow-list-monitors",
    "allow-list-system-fonts",
    "allow-signal-main-ready",
    "allow-install-update",
    "allow-ndi-available",
    "allow-ndi-start",
    "allow-ndi-stop",
    "allow-ndi-update",
    "allow-ndi-update-media",
    "allow-ndi-update-timer",
    "allow-syphon-available",
    "allow-syphon-start",
    "allow-syphon-stop",
    "allow-syphon-update",
    "allow-syphon-update-media",
    "allow-syphon-update-timer"
  ]
}
